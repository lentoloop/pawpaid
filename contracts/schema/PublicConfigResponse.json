{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublicConfigResponse",
  "type": "object",
  "required": [
    "claimant_id",
    "event_id",
    "llm_mode",
    "paypal_mode"
  ],
  "properties": {
    "claimant_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "llm_mode": {
      "$ref": "#/definitions/RuntimeMode"
    },
    "paypal_mode": {
      "$ref": "#/definitions/RuntimeMode"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "RuntimeMode": {
      "type": "string",
      "enum": [
        "mock",
        "sandbox",
        "manual",
        "gemini-free"
      ]
    }
  }
}
